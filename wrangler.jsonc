{
  "$schema": "https://wrangler.cloudflare.com/wrangler.json",
  "name": "x-content-ai-agent",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "x-content-agent",
      "database_id": "your-database-id-here"
    }
  ],
  "workflows": [
    {
      "name": "content-generation",
      "binding": "CONTENT_GENERATION",
      "class_name": "ContentGenerationWorkflow"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "x-content-agent-staging",
          "database_id": "your-staging-database-id-here"
        }
      ],
      "workflows": [
        {
          "name": "content-generation-staging",
          "binding": "CONTENT_GENERATION",
          "class_name": "ContentGenerationWorkflow"
        }
      ]
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "x-content-agent",
          "database_id": "your-database-id-here"
        }
      ],
      "workflows": [
        {
          "name": "content-generation",
          "binding": "CONTENT_GENERATION",
          "class_name": "ContentGenerationWorkflow"
        }
      ]
    }
  }
}